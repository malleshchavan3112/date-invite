# DateInvite — Environment Variables Template
# Copy this file to .env.local and populate with your real credentials.
# NEVER commit .env.local to Git.

# ─── Supabase (Database & Persistence) ──────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API Keys

# Public URL (safe to expose to browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key (safe to expose to browser client — RLS must be enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Service role key — SERVER ONLY. NEVER expose to client bundles or NEXT_PUBLIC_
# Used exclusively in server-side repositories, server actions, and scripts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ─── Resend (Transactional Email Notifications) ─────────────────────────────
# Found in: Resend Dashboard → API Keys (https://resend.com/api-keys)

# Resend API Key — SERVER ONLY. NEVER expose to browser or client code.
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Sender address (uses verified domain 'DateInvite <notifications@dateinvite.me>' in production,
# or 'DateInvite <onboarding@resend.dev>' for local sandbox testing).
RESEND_FROM_EMAIL=DateInvite <notifications@dateinvite.me>

# Optional base URL for public invitation links in notification emails (defaults to https://dateinvite.me)
NEXT_PUBLIC_APP_URL=https://dateinvite.me

# ─── Testmail (Testing & Inbox Verification) ────────────────────────────────
# Used ONLY in development / integration test scripts (scripts/test-email.ts).
# NEVER used in production code and NEVER exposed to browser bundles.
# Found in: Testmail Console (https://testmail.app/console)

# Testmail API Key — SERVER ONLY (test runner only)
TESTMAIL_API_KEY=your-testmail-api-key

# Testmail Namespace — SERVER ONLY (test runner only)
TESTMAIL_NAMESPACE=your-namespace
