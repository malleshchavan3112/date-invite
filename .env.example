# DateInvite — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to Git.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project → Settings → API Keys

# Public URL (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key (safe to expose — RLS must be enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Service role key — NEVER expose in NEXT_PUBLIC_ or client code
# Used ONLY in server-side code (Server Actions, Server Components)
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...
